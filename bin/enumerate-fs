#!/bin/bash

SCRIPTVERSION=1.0
SCRIPTNAME=$(basename "$0")

CATBIN=/usr/bin/cat
GREPBIN=/usr/bin/grep

function zcat() {
  xx=$(${CATBIN} ${2} 2>/dev/null)
  if [ "${xx}" ]; then
    echo -e "\e${1} ${3}:\e[00m"
    echo -e "${xx}\n"
  fi
}

function zgrep() {
  xx=$(${GREPBIN} ${2} 2>/dev/null)
  if [ "${xx}" ]; then
    echo -e "\e${1} ${3}:\e[00m"
    echo -e "${xx}\n"
  fi
}

function log_info() {
  echo "> $*"
}

function log_error() {
  echo "ERROR: $*" >&2
}

function log_warn() {
  echo "WARNING: $*" >&2
}

function log_detail() {
  echo ">> $*"
}

function do_system() {
  echo -e "\e[00;33m### SYSTEM ##############################################\e[00m"

  zcat "[00;31m[-]" "${1}/proc/version"  "Kernel information (continued)"
  zcat "[00;31m[-]" "${1}/etc/*-release" "Specific release information"
  zcat "[00;31m[-]" "${1}/etc/hostname"  "Hostname"
}

function do_usergroup() {
  echo -e "\e[00;33m### USER/GROUP ##########################################\e[00m"

  zgrep "[00;33m[+]" "-v '^[^:]*:[x]' ${1}/etc/passwd" "It looks like we have password hashes in /etc/passwd"
  zcat  "[00;31m[-]" "${1}/etc/passwd" "Contents of /etc/passwd"
}

function check_root() {
  if [[ $EUID -ne 0 ]]; then
    log_error "This script must be run with root privileges."
    echo ""
    echo "Please run: sudo $0 $*"
    exit 1
  fi
}

function show_usage() {
  ${CATBIN} << EOF
Usage: ${SCRIPTNAME} v${SCRIPTVERSION}
EXAMPLES:
  ${SCRIPTNAME} system
  ${SCRIPTNAME} -v|--version
  ${SCRIPTNAME} -h|--help
EOF
}

function show_version() {
  echo ${SCRIPTNAME} v${SCRIPTVERSION}
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case ${1} in
      system|user)
        COMMAND=${1}
        shift # past argument
        ;;
      -v|--version)
        COMMAND=version
        shift # past argument
        ;;
      -h|--help)
        COMMAND=help
        shift # past argument
        ;;
      *)
        if [[ $# -eq 1 ]]; then
          PATHNAME=${1}
          shift # past argument
        else
          echo "Unknown option ${1}"
          show_usage
          exit 1
        fi
        ;;
    esac
  done
}

main() {
  parse_args "$@"

  if [ "${COMMAND}" == "help" ]; then
    show_usage
    exit 0
  elif [ "${COMMAND}" == "version" ]; then
    show_version
    exit 0
  fi

  check_root "$@"

  if [ "${COMMAND}" == "system" ]; then
    do_system ${PATHNAME}
  elif [ "${COMMAND}" == "user" ]; then
    do_usergroup ${PATHNAME}
  elif [[ -z "${COMMAND}" ]]; then
    do_system ${PATHNAME}
    do_usergroup ${PATHNAME}
  fi
}

main "$@"


