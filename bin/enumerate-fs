#!/bin/bash

SCRIPTVERSION=1.1
SCRIPTNAME=$(basename "$0")

WBIN=/usr/bin/w
DFBIN=/usr/bin/df
IDBIN=/usr/bin/id
LSBIN=/usr/bin/ls
PSBIN=/usr/bin/ps
SSBIN=/usr/bin/ss
TRBIN=/usr/bin/tr
AWKBIN=/usr/bin/awk
CATBIN=/usr/bin/cat
CUTBIN=/usr/bin/cut
ENVBIN=/usr/bin/env
SEDBIN=/usr/bin/sed
DPKGBIN=/usr/bin/dpkg
FINDBIN=/usr/bin/find
GREPBIN=/usr/bin/grep
HEADBIN=/usr/bin/head
PSQLBIN=/usr/bin/psql
SUDOBIN=/usr/bin/sudo
TAILBIN=/usr/bin/tail
MYSQLBIN=/usr/bin/mysql
UNAMEBIN=/usr/bin/uname
WHICHBIN=/usr/bin/which
XARGSBIN=/usr/bin/xargs
WHOAMIBIN=/usr/bin/whoami
CRONTABBIN=/usr/bin/crontab
LASTLOGBIN=/usr/bin/lastlog
NETSTATBIN=/usr/bin/netstat
SYSTEMCTLBIN=/usr/bin/systemctl
MYSQLADMINBIN=/usr/bin/mysqladmin
SYSTEMDRESOLVEBIN=/usr/bin/systemd-resolve

IPSBIN=/usr/sbin/ip
ARPSBIN=/usr/sbin/arp
ROUTESBIN=/usr/sbin/route
GETCAPSBIN=/usr/sbin/getcap
APACHE2SBIN=/usr/sbin/apache2
IFCONFIGSBIN=/usr/sbin/ifconfig
SESTATUSSBIN=/usr/sbin/sestatus
APACHE2SBINCTL=/usr/sbin/apache2ctl

GETCAPXBIN=/sbin/getcap

JOHNBIN=john
UNSHADOWBIN=unshadow

EXTREME=no
USERNAME=${SUDO_USER}

BINLIST='aria2c\|arp\|ash\|awk\|base64\|bash\|busybox\|cat\|chmod\|chown\|cp\|csh\|curl\|cut\|dash\|date\|dd\|diff\|dmsetup\|docker\|ed\|emacs\|env\|expand\|expect\|file\|find\|flock\|fmt\|fold\|ftp\|gawk\|gdb\|gimp\|git\|grep\|head\|ht\|iftop\|ionice\|ip$\|irb\|jjs\|jq\|jrunscript\|ksh\|ld.so\|ldconfig\|less\|logsave\|lua\|make\|man\|mawk\|more\|mv\|mysql\|nano\|nawk\|nc\|netcat\|nice\|nl\|nmap\|node\|od\|openssl\|perl\|pg\|php\|pic\|pico\|python\|readelf\|rlwrap\|rpm\|rpmquery\|rsync\|ruby\|run-parts\|rvim\|scp\|script\|sed\|setarch\|sftp\|sh\|shuf\|socat\|sort\|sqlite3\|ssh$\|start-stop-daemon\|stdbuf\|strace\|systemctl\|tail\|tar\|taskset\|tclsh\|tee\|telnet\|tftp\|time\|timeout\|ul\|unexpand\|uniq\|unshare\|vi\|vim\|watch\|wget\|wish\|xargs\|xxd\|zip\|zsh'

function zshow() {
  echo -e "\e${1} ${3}:\e[00m"
  echo -e "${2}\n"
}

function zcheck() {
  if [ "${2}" ]; then
    zshow "${1}" "${2}" "${3}"
  fi
}

function zls() {
  xx=$(${LSBIN} ${2} 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zcat() {
  xx=$(${CATBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zfind() {
  xx=$(${FINDBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zgrep() {
  xx=$(${GREPBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function log_info() {
  echo "> $*"
}

function log_error() {
  echo "ERROR: $*" >&2
}

function log_warn() {
  echo "WARNING: $*" >&2
}

function log_detail() {
  echo ">> $*"
}

function do_system() {
  echo -e "\e[00;33m### SYSTEM ###############################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${UNAMEBIN} -a 2>/dev/null)" "Kernel information"
  fi

  zcat "[00;31m[-]" "${PATHNAME}/proc/version"  "Kernel information (continued)"
  zcat "[00;31m[-]" "${PATHNAME}/etc/*-release" "Specific release information"
  zcat "[00;31m[-]" "${PATHNAME}/etc/hostname"  "Hostname"
}

function do_usergroup() {
  echo -e "\e[00;33m### USER/GROUP ###########################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${IDBIN} 2>/dev/null)" "Current user/group info"

    lastlogedonusrs=$(${LASTLOGBIN} 2>/dev/null | ${TAILBIN} -n +2 | ${GREPBIN} -v 'Never' 2>/dev/null)
    zcheck "[00;31m[-]" "${lastlogedonusrs}" "Users that have previously logged onto the system"

    zcheck "[00;31m[-]" "$(${WBIN} 2>/dev/null | ${TAILBIN} -n +3)" "Who else is logged on"

    grpinfo=$(for i in $(${CUTBIN} -d':' -f1 /etc/passwd 2>/dev/null); do ${IDBIN} ${i}; done 2>/dev/null)
    zcheck "[00;31m[-]" "${grpinfo}" "Group memberships"

    adm_users=$(echo -e "${grpinfo}" | ${GREPBIN} '(adm)')
    zcheck "[00;31m[-]" "${adm_users}" "It looks like we have some admin users"
  fi

  zgrep "[00;33m[+]" "-v '^[^:]*:[x]' ${PATHNAME}/etc/passwd" "It looks like we have password hashes in ${PATHNAME}/etc/passwd"
  zcat  "[00;31m[-]" "${PATHNAME}/etc/passwd" "Contents of ${PATHNAME}/etc/passwd"
  if [ "${EXTREME}" == "yes" ]; then
    zcat  "[00;31m[-]" "${PATHNAME}/etc/group" "Contents of ${PATHNAME}/etc/group"
    zcat  "[00;31m[-]" "${PATHNAME}/etc/sudoers" "Contents of ${PATHNAME}/etc/sudoers"
  fi
  zcat  "[00;33m[+]" "${PATHNAME}/etc/shadow" "We can read the shadow file"
  zcat  "[00;33m[+]" "${PATHNAME}/etc/master.passwd" "We can read the master.passwd file"

  superman=$(${GREPBIN} -v -E '^#' ${PATHNAME}/etc/passwd 2>/dev/null | ${AWKBIN} -F: '$3 == 0 {print $1}' 2>/dev/null)
  zcheck "[00;31m[-]" "${superman}" "Super user account(s)"

  if [ "${EXTREME}" == "no" ]; then
    sudoers=$(${GREPBIN} -v -e '^$' ${PATHNAME}/etc/sudoers 2>/dev/null | ${GREPBIN} -v '#' 2>/dev/null)
    zcheck "[00;31m[-]" "${sudoers}" "Sudoers configuration (condensed)"
  fi

  if [[ -z "${PATHNAME}" ]]; then
    sudoperms=$(echo '' | ${SUDOBIN} -S -l -k 2>/dev/null)
    zcheck "[00;33m[+]" "${sudoperms}" "We can sudo without supplying a password"

    if [ "${PASSWORD}" ]; then
      if [ "${sudoperms}" ]; then
        :
      else
        sudoauth=$(echo ${PASSWORD} | ${SUDOBIN} -S -l -k 2>/dev/null)
        zcheck "[00;33m[+]" "${sudoauth}" "We can sudo when supplying a password"
      fi
    fi

    if [ "${PASSWORD}" ]; then
      if [ "${sudoperms}" ]; then
        :
      else
        sudopermscheck=$(echo ${PASSWORD} | ${SUDOBIN} -S -l -k 2>/dev/null | ${XARGSBIN} -n 1 2>/dev/null | ${SEDBIN} 's/,*$//g' 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
        zcheck "[00;33m[-]" "${sudopermscheck}" "Possible sudo pwnage"
      fi
    fi

    sudopwnage=$(echo '' | ${SUDOBIN} -S -l -k 2>/dev/null | ${XARGSBIN} -n 1 2>/dev/null | ${SEDBIN} 's/,*$//g' 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
    zcheck "[00;33m[+]" "${sudopwnage}" "Possible sudo pwnage"
  fi

  zfind "[00;31m[-]" "${PATHNAME}/home -name .sudo_as_admin_successful" "Accounts that have recently used sudo"
  zls "[00;33m[+]" "-ahl ${PATHNAME}/root/" "We can read root's home directory"
  zls "[00;31m[-]" "-ahl ${PATHNAME}/home/" "Are permissions on ${PATHNAME}/home directories lax"

  if [ "${EXTREME}" == "yes" ]; then
    grfilesall=$(${FINDBIN} ${PATHNAME}/ -writable ! -user ${USERNAME} -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${grfilesall}" "Files not owned by user but writable by group"
  fi

  if [ "${EXTREME}" == "yes" ]; then
    ourfilesall=$(${FINDBIN} ${PATHNAME}/ -user ${USERNAME} -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${ourfilesall}" "Files owned by our user"
  fi

  if [ "${EXTREME}" == "yes" ]; then
    hiddenfiles=$(${FINDBIN} ${PATHNAME}/ -name '.*' -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${hiddenfiles}" "Hidden files"
  fi

  if [ "${EXTREME}" == "yes" ]; then
    wrfileshm=$(${FINDBIN} ${PATHNAME}/home/ -perm -4 -type f -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${wrfileshm}" "World-readable files within ${PATHNAME}/home"
  fi

  if [ "${EXTREME}" == "yes" ]; then
    zls "[00;31m[-]" "-ahl ${PATHNAME}/home/${USERNAME}" "Home directory contents"
  fi

  sshfiles=$(${FINDBIN} ${PATHNAME}/ \( -name "id_dsa*" -o -name "id_rsa*" -o -name "known_hosts" -o -name "authorized_hosts" -o -name "authorized_keys" -o -name "*.pem" \) -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${sshfiles}" "SSH keys/host information found in the following locations"

  sshrootlogin=$(${GREPBIN} 'PermitRootLogin ' ${PATHNAME}/etc/ssh/sshd_config 2>/dev/null | ${GREPBIN} -v '#' | ${AWKBIN} '{print  $2}')
  if [ "${sshrootlogin}" = "yes" ]; then
    zcheck "[00;31m[-]" "$(${GREPBIN} 'PermitRootLogin ' ${PATHNAME}/etc/ssh/sshd_config 2>/dev/null | ${GREPBIN} -v '#')" "Root is allowed to login via SSH"
  fi
}

function do_environment() {
  echo -e "\e[00;33m### ENVIRONMENTAL ########################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${ENVBIN} 2>/dev/null | ${GREPBIN} -v 'LS_COLORS' 2>/dev/null)" "Environment information"
    zcheck "[00;31m[-]" "$(${SESTATUSSBIN} 2>/dev/null)" "SELinux seems to be present"

    pathinfo=$(echo ${PATH} 2>/dev/null)
    if [ "${pathinfo}" ]; then
      zcheck "[00;31m[-]" "$(${LSBIN} -ld $(echo ${PATH} | ${TRBIN} ':' ' '))" "Path information"
    fi
  fi

  zcat "[00;31m[-]" "${PATHNAME}/etc/shells" "Available shells"

  zcheck "[00;31m[-]" "$(umask -S 2>/dev/null & umask 2>/dev/null)" "Current umask value"

  zcheck "[00;31m[-]" "$(${GREPBIN} -i '^UMASK' ${PATHNAME}/etc/login.defs)" "umask value as specified in ${PATHNAME}/etc/login.defs"
  zcheck "[00;31m[-]" "$(${GREPBIN} '^PASS_MAX_DAYS\|^PASS_MIN_DAYS\|^PASS_WARN_AGE\|^ENCRYPT_METHOD' ${PATHNAME}/etc/login.defs)" "Password and storage information"
}

function do_job() {
  echo -e "\e[00;33m### JOBS/TASKS ###########################################\e[00m"

  zls "[00;31m[-]" "${PATHNAME}/etc/cron*" "Cron jobs"

  cronjobwwperms=$(${FINDBIN} ${PATHNAME}/etc/cron* -perm -0002 -type f -exec ${LSBIN} -la {} \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${cronjobwwperms}" "World-writable cron jobs and file contents"

  zcat "[00;31m[-]" "${PATHNAME}/etc/crontab" "Crontab contents"
  zls "[00;31m[-]" "-la ${PATHNAME}/var/spool/cron/crontabs" "Anything interesting in ${PATHNAME}/var/spool/cron/crontabs"

  anacronjobs=$(${LSBIN} -la ${PATHNAME}/etc/anacrontab 2>/dev/null; ${CATBIN} ${PATHNAME}/etc/anacrontab 2>/dev/null)
  zcheck "[00;31m[-]" "${anacronjobs}" "Anacron jobs and associated file permissions"

  anacrontab=$(${LSBIN} -la ${PATHNAME}/var/spool/anacron 2>/dev/null)
  zcheck "[00;31m[-]" "${anacrontab}" "When were jobs last executed (${PATHNAME}/var/spool/anacron contents)"

  if [[ -z "${PATHNAME}" ]]; then
    cronother=$(${CUTBIN} -d ":" -f 1 ${PATHNAME}/etc/passwd | ${XARGSBIN} -n1 ${CRONTABBIN} -l -u 2>/dev/null)
    zcheck "[00;31m[-]" "${cronother}" "Jobs held by all users"

    if [ "${EXTREME}" == "yes" ]; then
      systemdtimers=$(${SYSTEMCTLBIN} list-timers --all 2>/dev/null)
    else
      systemdtimers=$(${SYSTEMCTLBIN} list-timers 2>/dev/null | ${HEADBIN} -n -1 2>/dev/null)
    fi
    zcheck "[00;31m[-]" "${systemdtimers}" "Systemd timers"
  fi
}

function do_network() {
  echo -e "\e[00;33m### NETWORKING  ##########################################\e[00m"

  nicinfo=$(${IFCONFIGSBIN} -a 2>/dev/null)
  zcheck "[00;31m[-]" "${nicinfo}" "Network and IP info"

  if [[ -z "${nicinfo}" ]]; then
    nicinfoip=$(${IPSBIN} a 2>/dev/null)
    zcheck "[00;31m[-]" "${nicinfoip}" "Network and IP info"
  fi

  arpinfo=$(${ARPSBIN} -a 2>/dev/null)
  zcheck "[00;31m[-]" "${arpinfo}" "ARP history"

  if [[ -z "${arpinfo}" ]]; then
    arpinfoip=$(${IPSBIN} n 2>/dev/null)
    zcheck "[00;31m[-]" "${arpinfoip}" "ARP history"
  fi

  nsinfo=$(${GREPBIN} "nameserver" ${PATHNAME}/etc/resolv.conf 2>/dev/null)
  zcheck "[00;31m[-]" "${nsinfo}" "Nameserver(s)"

  nsinfosysd=$(${SYSTEMDRESOLVEBIN} --status 2>/dev/null)
  zcheck "[00;31m[-]" "${nsinfosysd}" "Nameserver(s)"

  defroute=$(${ROUTESBIN} 2>/dev/null | ${GREPBIN} default)
  zcheck "[00;31m[-]" "${defroute}" "Default route"

  defrouteip=$(${IPSBIN} r 2>/dev/null | ${GREPBIN} default)
  zcheck "[00;31m[-]" "${defrouteip}" "Default route"

  tcpservs=$(${NETSTATBIN} -ntpl 2>/dev/null)
  zcheck "[00;31m[-]" "${tcpservs}" "Listening TCP"

  if [[ -z "${tcpservs}" ]]; then
    tcpservsip=$(${SSBIN} -t -l -n 2>/dev/null)
    zcheck "[00;31m[-]" "${tcpservsip}" "Listening TCP"
  fi

  udpservs=$(${NETSTATBIN} -nupl 2>/dev/null)
  zcheck "[00;31m[-]" "${udpservs}" "Listening UDP"

  if [[ -z "${udpservs}" ]]; then
    udpservsip=$(${SSBIN} -u -l -n 2>/dev/null)
    zcheck "[00;31m[-]" "${udpservsip}" "Listening UDP"
  fi
}

function do_services() {
  echo -e "\e[00;33m### SERVICES #############################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    psaux=$(${PSBIN} aux 2>/dev/null)
    zcheck "[00;31m[-]" "${psaux}" "Running processes"

    procperm=$(${PSBIN} aux 2>/dev/null | ${AWKBIN} '{print $11}' | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null | ${AWKBIN} '!x[$0]++' 2>/dev/null)
    zcheck "[00;31m[-]" "${procperm}" "Process binaries and associated permissions (from above list)"
  fi

  zcat "[00;31m[-]" "${PATHNAME}/etc/inetd.conf" "Contents of /etc/inetd.conf"

  inetdbinperms=$(${AWKBIN} '{print $7}' ${PATHNAME}/etc/inetd.conf 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${inetdbinperms}" "The related inetd binary permissions"

  zcat "[00;31m[-]" "${PATHNAME}/etc/xinetd.conf" "The related inetd binary permissions"

  xinetdincd=$(${GREPBIN} "/etc/xinetd.d" ${PATHNAME}/etc/xinetd.conf 2>/dev/null)
  zcheck "[00;31m[-]" "${xinetdincd}" "/etc/xinetd.d is included in ${PATHNAME}/etc/xinetd.conf - associated binary permissions are listed below"

  xinetdbinperms=$(${AWKBIN} '{print $7}' ${PATHNAME}/etc/xinetd.conf 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${xinetdbinperms}" "The related xinetd binary permissions"

  initdread=$(${LSBIN} -la ${PATHNAME}/etc/init.d 2>/dev/null)
  zcheck "[00;31m[-]" "${initdread}" "${PATHNAME}/etc/init.d/ binary permissions"

  initdperms=$(${FINDBIN} ${PATHNAME}/etc/init.d/ \! -uid 0 -type f 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${initdperms}" "${PATHNAME}/etc/init.d/ files not belonging to root"

  rcdread=$(${LSBIN} -la ${PATHNAME}/etc/rc.d/init.d 2>/dev/null)
  zcheck "[00;31m[-]" "${rcdread}" "${PATHNAME}/etc/rc.d/init.d binary permissions"

  rcdperms=$(${FINDBIN} ${PATHNAME}/etc/rc.d/init.d \! -uid 0 -type f 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${rcdperms}" "${PATHNAME}/etc/rc.d/init.d files not belonging to root"

  usrrcdread=$(${LSBIN} -la ${PATHNAME}/usr/local/etc/rc.d 2>/dev/null)
  zcheck "[00;31m[-]" "${usrrcdread}" "${PATHNAME}/usr/local/etc/rc.d binary permissions"

  usrrcdperms=$(${FINDBIN} ${PATHNAME}/usr/local/etc/rc.d \! -uid 0 -type f 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${usrrcdperms}" "${PATHNAME}/usr/local/etc/rc.d files not belonging to root"

  zls "[00;31m[-]" "-la ${PATHNAME}/etc/init/" "${PATHNAME}/etc/init/ config file permissions"

  initperms=$(${FINDBIN} ${PATHNAME}/etc/init \! -uid 0 -type f 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;31m[-]" "${initperms}" "${PATHNAME}/etc/init/ config files not belonging to root"

  zls "[00;31m[-]" "-lthR ${PATHNAME}/lib/systemd/" "${PATHNAME}/lib/systemd/* config file permissions"

  systemdperms=$(${FINDBIN} ${PATHNAME}/lib/systemd/ \! -uid 0 -type f 2>/dev/null | ${XARGSBIN} -r ${LSBIN} -la 2>/dev/null)
  zcheck "[00;33m[+]" "${systemdperms}" "${PATHNAME}/lib/systemd/* config files not belonging to root"
}

function do_software {
  echo -e "\e[00;33m### SOFTWARE #############################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    sudover=$(${SUDOBIN} -V 2>/dev/null | ${GREPBIN} "Sudo version" 2>/dev/null)
    zcheck "[00;31m[-]" "${sudover}" "Sudo version"

    mysqlver=$(${MYSQLBIN} --version 2>/dev/null)
    zcheck "[00;31m[-]" "${mysqlver}" "MYSQL version"

    mysqlconnect=$(${MYSQLADMINBIN} -uroot -proot version 2>/dev/null)
    zcheck "[00;33m[+]" "${mysqlconnect}" "We can connect to the local MYSQL service with default root/root credentials"

    mysqlconnectnopass=$(${MYSQLADMINBIN} -uroot version 2>/dev/null)
    zcheck "[00;33m[+]" "${mysqlconnectnopass}" "We can connect to the local MYSQL service as 'root' and without a password"

    postgver=$(${PSQLBIN} -V 2>/dev/null)
    zcheck "[00;31m[-]" "${postgver}" "Postgres version"

    postcon1=$(${PSQLBIN} -U postgres -w template0 -c 'select version()' 2>/dev/null | ${GREPBIN} version)
    zcheck "[00;33m[+]" "${postcon1}" "We can connect to Postgres DB 'template0' as user 'postgres' with no password"

    postcon11=$(${PSQLBIN} -U postgres -w template1 -c 'select version()' 2>/dev/null | ${GREPBIN} version)
    zcheck "[00;33m[+]" "${postcon11}" "We can connect to Postgres DB 'template1' as user 'postgres' with no password"

    postcon2=$(${PSQLBIN} -U pgsql -w template0 -c 'select version()' 2>/dev/null | ${GREPBIN} version)
    zcheck "[00;33m[+]" "${postcon2}" "We can connect to Postgres DB 'template0' as user 'psql' with no password"

    postcon22=$(${PSQLBIN} -U pgsql -w template1 -c 'select version()' 2>/dev/null | ${GREPBIN} version)
    zcheck "[00;33m[+]" "${postcon22}" "We can connect to Postgres DB 'template1' as user 'psql' with no password"

    apachever=$(${APACHE2SBIN} -v 2>/dev/null; httpd -v 2>/dev/null)
    zcheck "[00;31m[-]" "${apachever}" "Apache version"
  fi

  apacheusr=$(${GREPBIN} -i 'user\|group' ${PATHNAME}/etc/apache2/envvars 2>/dev/null | ${AWKBIN} '{sub(/.*\export /,"")}1' 2>/dev/null)
  zcheck "[00;31m[-]" "${apacheusr}" "Apache user configuration"

  if [[ -z "${PATHNAME}" ]]; then
    apachemodules=$(${APACHE2SBINCTL} -M 2>/dev/null; httpd -M 2>/dev/null)
    zcheck "[00;31m[-]" "${apachemodules}" "Installed Apache modules"
  fi

  htpasswd=$(${FINDBIN} ${PATHNAME}/ -name .htpasswd -print -exec ${CATBIN} {} \; 2>/dev/null)
  zcheck "[00;33m[-]" "${htpasswd}" "htpasswd found - could contain passwords"

  if [ "${EXTREME}" == "yes" ]; then
    apachehomedirs=$(${LSBIN} -alhR ${PATHNAME}/var/www/ 2>/dev/null; ${LSBIN} -alhR ${PATHNAME}/srv/www/htdocs/ 2>/dev/null; ${LSBIN} -alhR ${PATHNAME}/usr/local/www/apache2/data/ 2>/dev/null; ${LSBIN} -alhR ${PATHNAME}/opt/lampp/htdocs/ 2>/dev/null)
    zcheck "[00;31m[-]" "${apachehomedirs}" "www home dir contents"
  fi
}

function do_files() {
  echo -e "\e[00;33m### INTERESTING FILES ####################################\e[00m"

  whichloc=$(${WHICHBIN} nc 2>/dev/null ; ${WHICHBIN} netcat 2>/dev/null ; ${WHICHBIN} wget 2>/dev/null ; ${WHICHBIN} nmap 2>/dev/null ; ${WHICHBIN} gcc 2>/dev/null; ${WHICHBIN} curl 2>/dev/null)
  zcheck "[00;31m[-]" "${whichloc}" "Useful file locations"

  if [[ -z "${PATHNAME}" ]]; then
    compiler=$(${DPKGBIN} --list 2>/dev/null | ${GREPBIN} compiler | ${GREPBIN} -v decompiler 2>/dev/null && yum list installed 'gcc*' 2>/dev/null | ${GREPBIN} gcc 2>/dev/null)
    zcheck "[00;31m[-]" "${compiler}" "Installed compilers"
  fi

  showfiles=$(${LSBIN} -la ${PATHNAME}/etc/passwd 2>/dev/null ; ${LSBIN} -la ${PATHNAME}/etc/group 2>/dev/null ; ${LSBIN} -la ${PATHNAME}/etc/profile 2>/dev/null; ${LSBIN} -la ${PATHNAME}/etc/shadow 2>/dev/null ; ${LSBIN} -la ${PATHNAME}/etc/master.passwd 2>/dev/null)
  zcheck "[00;31m[-]" "${showfiles}" "Can we read/write sensitive files"

  allsuid=$(${FINDBIN} ${PATHNAME}/ -perm -4000 -type f 2>/dev/null)
  findsuid=$(${FINDBIN} ${allsuid} -perm -4000 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${findsuid}" "SUID files"

  intsuid=$(${FINDBIN} ${allsuid} -perm -4000 -type f -exec ${LSBIN} -la {} \; 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
  zcheck "[00;33m[+]" "${intsuid}" "Possibly interesting SUID files"

  wwsuid=$(${FINDBIN} ${allsuid} -perm -4002 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${wwsuid}" "World-writable SUID files"

  wwsuidrt=$(${FINDBIN} ${allsuid} -uid 0 -perm -4002 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${wwsuidrt}" "World-writable SUID files owned by root"

  allsgid=$(${FINDBIN} ${PATHNAME}/ -perm -2000 -type f 2>/dev/null)
  findsgid=$(${FINDBIN} ${allsgid} -perm -2000 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${findsgid}" "SGID files"

  intsgid=$(${FINDBIN} ${allsgid} -perm -2000 -type f -exec ${LSBIN} -la {} \; 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
  zcheck "[00;33m[+]" "${intsgid}" "Possibly interesting SGID files"

  wwsgid=$(${FINDBIN} ${allsgid} -perm -2002 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${wwsgid}" "World-writable SGID files"

  wwsgidrt=$(${FINDBIN} ${allsgid} -uid 0 -perm -2002 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${wwsgidrt}" "World-writable SGID files owned by root"

  if [[ -z "${PATHNAME}" ]]; then
    fileswithcaps=$(${GETCAPSBIN} -r / 2>/dev/null || ${GETCAPXBIN} -r / 2>/dev/null)
    zcheck "[00;31m[+]" "${fileswithcaps}" "Files with POSIX capabilities set"
  fi

  userswithcaps=$(${GREPBIN} -v '^#\|none\|^$' ${PATHNAME}/etc/security/capability.conf 2>/dev/null)
  zcheck "[00;33m[+]" "${userswithcaps}" "Users with specific POSIX capabilities"

  if [ "${userswithcaps}" ] ; then
    matchedcaps=$(echo -e "${userswithcaps}" | ${GREPBIN} ${USERNAME} | ${AWKBIN} '{print $1}' 2>/dev/null)
    zcheck "[00;33m[+]" "${matchedcaps}" "Capabilities associated with the current user"

    if [ "${matchedcaps}" ] && [ "${fileswithcaps}" ]; then
      matchedfiles=$(echo -e "${matchedcaps}" | while read -r cap ; do echo -e "${fileswithcaps}" | ${GREPBIN} "${cap}" ; done 2>/dev/null)
      zcheck "[00;33m[+]" "${matchedcaps}" "Files with the same capabilities associated with the current user (You may want to try abusing those capabilties)"

      if [ "$matchedfiles" ]; then
        matchedfilesperms=$(echo -e "${matchedfiles}" | ${AWKBIN} '{print $1}' | while read -r f; do ${LSBIN} -la ${f} ;done 2>/dev/null)
        zcheck "[00;33m[+]" "${matchedfilesperms}" "Permissions of files with the same capabilities associated with the current user"

        if [ "${matchedfilesperms}" ]; then
          writablematchedfiles=$(echo -e "${matchedfiles}" | ${AWKBIN} '{print $1}' | while read -r f; do ${FINDBIN} ${f} -writable -exec ${LSBIN} -la {} + ;done 2>/dev/null)
          zcheck "[00;33m[+]" "${writablematchedfiles}" "User/Group writable files with the same capabilities associated with the current user"
        fi
      fi
    fi
  fi

  if [ "${EXTREME}" == "yes" ]; then
    privatekeyfiles=$(${GREPBIN} -rl "PRIVATE KEY-----" ${PATHNAME}/home 2>/dev/null)
    zcheck "[00;33m[+]" "${privatekeyfiles}" "Private SSH keys found"

    awskeyfiles=$(${GREPBIN} -rli "aws_secret_access_key" ${PATHNAME}/home 2>/dev/null)
    zcheck "[00;33m[+]" "${awskeyfiles}" "AWS secret keys found"

    gitcredfiles=$(${FINDBIN} ${PATHNAME}/ -name ".git-credentials" 2>/dev/null)
    zcheck "[00;33m[+]" "${gitcredfiles}" "Git credentials saved on the machine"

    wwfiles=$(${FINDBIN} ${PATHNAME}/ ! -path "*/proc/*" ! -path "/sys/*" -perm -2 -type f -exec ${LSBIN} -la {} 2>/dev/null \;)
    zcheck "[00;31m[-]" "${wwfiles}" "World-writable files (excluding /proc and /sys)"
  fi

  usrplan=$(${FINDBIN} ${PATHNAME}/home -iname *.plan -exec ${LSBIN} -la {} \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${usrplan}" "Plan file permissions and contents"

  bsdusrplan=$(${FINDBIN} ${PATHNAME}/usr/home -iname *.plan -exec ${LSBIN} -la {} \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${bsdusrplan}" "Plan file permissions and contents"

  rhostsusr=$(${FINDBIN} ${PATHNAME}/home -iname *.rhosts -exec ${LSBIN} -la {} 2>/dev/null \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${rhostsusr}" "rhost config file(s) and file contents"

  bsdrhostsusr=$(${FINDBIN} ${PATHNAME}/usr/home -iname *.rhosts -exec ${LSBIN} -la {} 2>/dev/null \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${bsdrhostsusr}" "rhost config file(s) and file contents"

  rhostssys=$(${FINDBIN} ${PATHNAME}/etc -iname hosts.equiv -exec ${LSBIN} -la {} 2>/dev/null \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${rhostssys}" "Hosts.equiv file and contents"

  nfsexports=$(${LSBIN} -la ${PATHNAME}/etc/exports 2>/dev/null; ${CATBIN} ${PATHNAME}/etc/exports 2>/dev/null)
  zcheck "[00;31m[-]" "${nfsexports}" "NFS config details"

  fstab=$(${CATBIN} ${PATHNAME}/etc/fstab 2>/dev/null)
  zcheck "[00;31m[-]" "${fstab}" "NFS displaying partitions and filesystems - you need to check if exotic filesystems"

  fstab=$(${GREPBIN} username ${PATHNAME}/etc/fstab 2>/dev/null | ${AWKBIN} '{sub(/.*\username=/,"");sub(/\,.*/,"")}1' 2>/dev/null | ${XARGSBIN} -r echo username: 2>/dev/null; ${GREPBIN} password ${PATHNAME}/etc/fstab 2>/dev/null | ${AWKBIN} '{sub(/.*\password=/,"");sub(/\,.*/,"")}1' 2>/dev/null | ${XARGSBIN} -r echo password: 2>/dev/null; ${GREPBIN} domain ${PATHNAME}/etc/fstab 2>/dev/null | ${AWKBIN} '{sub(/.*\domain=/,"");sub(/\,.*/,"")}1' 2>/dev/null | ${XARGSBIN} -r echo domain: 2>/dev/null)
  zcheck "[00;33m[+]" "${fstab}" "Looks like there are credentials in ${PATHNAME}/etc/fstab"

  fstabcred=$(${GREPBIN} cred ${PATHNAME}/etc/fstab 2>/dev/null | ${AWKBIN} '{sub(/.*\credentials=/,"");sub(/\,.*/,"")}1' 2>/dev/null | ${XARGSBIN} -I{} sh -c 'ls -la {}; cat {}' 2>/dev/null)
  zcheck "[00;33m[+]" "${fstabcred}" "${PATHNAME}/etc/fstab contains a credentials file"

  if [ "${KEYWORD}" = "" ];then
    echo -e "[-] Can't search *.conf files as no keyword was entered\n"
  else
    confkey=$(${FINDBIN} ${PATHNAME}/ -maxdepth 4 -name *.conf -type f -exec ${GREPBIN} -Hn ${KEYWORD} {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${confkey}" "Find keyword (${KEYWORD}) in .conf files (recursive 4 levels - output format filepath:identified line number where keyword appears)"
  fi

  if [ "${KEYWORD}" = "" ];then
    echo -e "[-] Can't search *.php files as no keyword was entered\n"
  else
    phpkey=$(${FINDBIN} ${PATHNAME}/ -maxdepth 10 -name *.php -type f -exec ${GREPBIN} -Hn ${KEYWORD} {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${phpkey}" "Find keyword (${KEYWORD}) in .php files (recursive 10 levels - output format filepath:identified line number where keyword appears)"
  fi

  if [ "${KEYWORD}" = "" ];then
    echo -e "[-] Can't search *.log files as no keyword was entered\n"
  else
    logkey=$(${FINDBIN} ${PATHNAME}/ -maxdepth 4 -name *.log -type f -exec ${GREPBIN} -Hn ${KEYWORD} {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${logkey}" "Find keyword (${KEYWORD}) in .log files (recursive 4 levels - output format filepath:identified line number where keyword appears)"
  fi

  if [ "${KEYWORD}" = "" ];then
    echo -e "[-] Can't search *.ini files as no keyword was entered\n"
  else
    inikey=$(${FINDBIN} ${PATHNAME}/ -maxdepth 4 -name *.ini -type f -exec ${GREPBIN} -Hn ${KEYWORD} {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${inikey}" "Find keyword (${KEYWORD}) in .ini files (recursive 4 levels - output format filepath:identified line number where keyword appears)"
  fi

  allconf=$(${FINDBIN} ${PATHNAME}/etc/ -maxdepth 1 -name *.conf -type f -exec ${LSBIN} -la {} \; 2>/dev/null)
  zcheck "[00;31m[-]" "${allconf}" "All *.conf files in /etc (recursive 1 level)"

  if [ "${EXTREME}" == "yes" ]; then
    roothist=$(${LSBIN} -la ${PATHNAME}/.*_history 2>/dev/null)
    zcheck "[00;33m[+]" "${roothist}" "History files are accessible"
  else
    usrhist=$(${LSBIN} -la ${PATHNAME}/home/${USERNAME}/.*_history 2>/dev/null)
    zcheck "[00;31m[-]" "${usrhist}" "Current user's history files"

    roothist=$(${LSBIN} -la ${PATHNAME}/root/.*_history 2>/dev/null)
    zcheck "[00;33m[+]" "${roothist}" "Root's history files are accessible"
  fi

  checkbashhist=$(${FINDBIN} ${PATHNAME}/home -name .bash_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checkbashhist}" "Location and contents (if accessible) of .bash_history file(s)"

  checkprofile=$(${FINDBIN} ${PATHNAME}/home -name .profile -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checkprofile}" "Location and contents (if accessible) of .profile file(s)"

  checkbashrc=$(${FINDBIN} ${PATHNAME}/home -name .bashrc -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checkbashrc}" "Location and contents (if accessible) of .bashrc file(s)"

  checkmysql=$(${FINDBIN} ${PATHNAME}/home -name .mysql_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checkmysql}" "Location and contents (if accessible) of .mysql_history file(s)"

  checkpsql=$(${FINDBIN} ${PATHNAME}/home -name .psql_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checkpsql}" "Location and contents (if accessible) of .psql_history file(s)"

  checknano=$(${FINDBIN} ${PATHNAME}/home -name .nano_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checknano}" "Location and contents (if accessible) of .nano_history file(s)"

  checktftp=$(${FINDBIN} ${PATHNAME}/home -name .atftp_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checktftp}" "Location and contents (if accessible) of .atftp_history file(s)"

  checktftp=$(${FINDBIN} ${PATHNAME}/home -name .viminfo -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checktftp}" "Location and contents (if accessible) of .viminfo file(s)"

  checktftp=$(${FINDBIN} ${PATHNAME}/home -name .zsh_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checktftp}" "Location and contents (if accessible) of .zsh_history file(s)"

  checktftp=$(${FINDBIN} ${PATHNAME}/home -name .python_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checktftp}" "Location and contents (if accessible) of .python_history file(s)"

  checktftp=$(${FINDBIN} ${PATHNAME}/home -name .sh_history -print -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${checktftp}" "Location and contents (if accessible) of .sh_history file(s)"

  bakfiles=$(${FINDBIN} ${PATHNAME}/ \( -name "*.bak" -o -name "*backup*" -o -name "*.old" \) -type f 2</dev/null | ${XARGSBIN} ${LSBIN} -la)
  zcheck "[00;31m[-]" "${bakfiles}" "Location and Permissions (if accessible) of .bak file(s)"

  readmail=$(${LSBIN} -la ${PATHNAME}/var/mail 2>/dev/null)
  zcheck "[00;31m[-]" "${readmail}" "Any interesting mail in ${PATHNAME}/var/mail"

  readmailroot=$(${HEADBIN} ${PATHNAME}/var/mail/root 2>/dev/null)
  zcheck "[00;33m[+]" "${readmailroot}" "We can read ${PATHNAME}/var/mail/root! (snippet below)"

  credinfo=$(${FINDBIN} ${PATHNAME}/var/log -type f -readable | ${XARGSBIN} ${GREPBIN} -li 'password\|user\|login\|credential')
  zcheck "[00;33m[+]" "${credinfo}" "Checking for possible credentials ${PATHNAME}/var/log"

  if [ "${EXTREME}" == "yes" ]; then
    confinfo=$(${FINDBIN} ${PATHNAME}/home -type f -name "*.txt" -o -name "*.cfg" -o -name "*.conf" 2>/dev/null)
    zcheck "[00;33m[+]" "${confinfo}" "Check for possible credentials ${PATHNAME}/home"

    passinfo=$(${FINDBIN} ${PATHNAME}/home -type f -name "*pass*" -o -name "*cred*" 2>/dev/null)
    zcheck "[00;33m[+]" "${passinfo}" "Check for possible credentials ${PATHNAME}/home"

    rootinfo=$(${FINDBIN} ${PATHNAME}/root -type f -name "*.txt" -o -name "*.cfg" -o -name "*.conf" 2>/dev/null)
    zcheck "[00;33m[+]" "${rootinfo}" "Check for possible credentials ${PATHNAME}/root"
  else
    confinfo=$(${FINDBIN} ${PATHNAME}/home -type f -name "*.txt" -o -name "*.cfg" -o -name "*.conf" 2>/dev/null | ${XARGSBIN} ${GREPBIN} -li "password\|user\|credential")
    zcheck "[00;33m[+]" "${confinfo}" "Check for possible credentials ${PATHNAME}/home"
  fi

  confinfo=$(${FINDBIN} ${PATHNAME}/etc -type f -name "*.conf" -o -name "*.cfg" -o -name "*.config" -o 2>/dev/null | ${XARGSBIN} ${GREPBIN} -li "password\|passwd\|pwd\|user\|credential")
  zcheck "[00;33m[+]" "${confinfo}" "Check for possible credentials ${PATHNAME}/etc"

  serverinfo=$(${GREPBIN} -r "password\|passwd\|pwd\|user\|credential" ${PATHNAME}/etc/apache2/ ${PATHNAME}/etc/nginx/ ${PATHNAME}/etc/httpd/ 2>/dev/null)
  zcheck "[00;33m[+]" "${serverinfo}" "Check for possible server credentials"

  postgresinfo=$(${GREPBIN} -r "password\|passwd\|pwd\|user\|credential" ${PATHNAME}/etc/mysql/ ${PATHNAME}/etc/postgresql/ 2>/dev/null)
  zcheck "[00;33m[+]" "${postgresinfo}" "Check for possible postgresgl credentials"

  wpconfinfo=$(${FINDBIN} ${PATHNAME}/var/www -type f -name "wp-config.php" -o -name "configuration.php" -o -name "config.inc.php" 2>/dev/null | ${XARGSBIN} ${GREPBIN} -li "password\|passwd\|pwd\|user\|credentials")
  zcheck "[00;33m[+]" "${wpconfinfo}" "Check for possible web applications credentials"

  wpconfinfo=$(${FINDBIN} ${PATHNAME}/var -type f -name "settings.php" 2>/dev/null | ${XARGSBIN} ${GREPBIN} -li "password\|passwd\|pwd\|user\|credential")
  zcheck "[00;33m[+]" "${wpconfinfo}" "Check for possible web applications credentials"

  if [[ -z "${PATHNAME}" ]]; then
    dfinfo=$(${DFBIN} -h | ${GREPBIN} -v "tmpfs\|proc\|sysfs\|devtmpfs\|cgroup")
    zcheck "[00;33m[+]" "${dfinfo}" "Check for uncommon filesystems"
  fi

  backinfo=$(${FINDBIN} ${PATHNAME}/var/backup -type f 2>/dev/null)
  zcheck "[00;33m[+]" "${backinfo}" "Location and contents ${PATHNAME}/var/backup"

  logsinfo=$(${FINDBIN} ${PATHNAME}/var/logs -type f 2>/dev/null)
  zcheck "[00;33m[+]" "${logsinfo}" "Location and contents ${PATHNAME}/var/logs"

  optinfo=$(${FINDBIN} ${PATHNAME}/opt -type f -perm -o+r 2>/dev/null)
  zcheck "[00;33m[+]" "${optinfo}" "Location and contents ${PATHNAME}/opt"
}

function do_end() {
  echo -e "\e[00;33m### SCAN COMPLETE ########################################\e[00m"
}

function do_crack() {
  echo -e "\e[00;33m### CRACK ################################################\e[00m"

  ${CATBIN} ${PATHNAME}/etc/shadow | ${GREPBIN} -v ":\*:" | ${GREPBIN} -v ":!" > hashes.txt
  ${JOHNBIN} --format=sha512crypt hashes.txt

  ${UNSHADOWBIN} ${PATHNAME}/etc/passwd ${PATHNAME}/etc/shadow > unshadowed.txt
  ${JOHNBIN} --wordlist=/usr/share/wordlists/rockyou.txt unshadowed.txt
}

function check_root() {
  if [[ $EUID -ne 0 ]]; then
    log_error "This script must be run with root privileges."
    echo ""
    echo "Please run: sudo $0 $*"
    exit 1
  fi
}

function show_usage() {
  ${CATBIN} << EOF
Usage: ${SCRIPTNAME} v${SCRIPTVERSION}
EXAMPLES:
  ${SCRIPTNAME} job
  ${SCRIPTNAME} user
  ${SCRIPTNAME} files
  ${SCRIPTNAME} system
  ${SCRIPTNAME} network
  ${SCRIPTNAME} services
  ${SCRIPTNAME} software
  ${SCRIPTNAME} environment
  ${SCRIPTNAME} -v|--version
  ${SCRIPTNAME} -h|--help
EOF
}

function show_license() {
  ${CATBIN} << EOF
  COPYRIGHT
  MIT License

  Copyright (c) 2025 Kyle Wickens

  Permission is hereby granted, free of charge, to any person obtaining a copy
  of this software and associated documentation files (the "Software"), to deal
  in the Software without restriction, including without limitation the rights
  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
  copies of the Software, and to permit persons to whom the Software is
  furnished to do so, subject to the following conditions:

  The above copyright notice and this permission notice shall be included in all
  copies or substantial portions of the Software.

  THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
  SOFTWARE.
EOF
}

function show_version() {
  echo ${SCRIPTNAME} v${SCRIPTVERSION}
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case ${1} in
      end|job|user|files|system|network|services|software|environment|crack)
        COMMAND=${1}
        shift # past argument
        ;;
      -v|--version)
        COMMAND=version
        shift # past argument
        ;;
      -h|--help)
        COMMAND=help
        shift # past argument
        ;;
      -k|--keyword)
        KEYWORD=${2}
        shift # past argument
        shift # past argument
        ;;
      -p|--password)
        PASSWORD=${2}
        shift # past argument
        shift # past argument
        ;;
      -u|--username)
        USERNAME=${2}
        shift # past argument
        shift # past argument
        ;;
      -x|--extreme)
        EXTREME=yes
        shift # past argument
        ;;
      *)
        if [[ $# -eq 1 ]]; then
          PATHNAME=${1}
          shift # past argument
        else
          echo "Unknown option ${1}"
          show_usage
          exit 1
        fi
        ;;
    esac
  done
}

main() {
  parse_args "$@"

  if [ "${COMMAND}" == "help" ]; then
    show_usage
    exit 0
  elif [ "${COMMAND}" == "version" ]; then
    show_version
    echo
    show_license
    exit 0
  fi

  check_root "$@"

  if [ "${COMMAND}" == "end" ]; then
    do_end
  elif [ "${COMMAND}" == "job" ]; then
    do_job
  elif [ "${COMMAND}" == "user" ]; then
    do_usergroup
  elif [ "${COMMAND}" == "files" ]; then
    do_files
  elif [ "${COMMAND}" == "system" ]; then
    do_system
  elif [ "${COMMAND}" == "network" ]; then
    do_network
  elif [ "${COMMAND}" == "services" ]; then
    do_services
  elif [ "${COMMAND}" == "software" ]; then
    do_software
  elif [ "${COMMAND}" == "environment" ]; then
    do_environment
  elif [ "${COMMAND}" == "crack" ]; then
    do_crack
  elif [[ -z "${COMMAND}" ]]; then
    do_system
    do_usergroup
    do_environment
    do_job
    do_network
    do_services
    do_software
    do_files
    do_end
  fi
}

main "$@"


