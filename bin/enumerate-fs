#!/bin/bash

SCRIPTVERSION=1.0
SCRIPTNAME=$(basename "$0")

WBIN=/usr/bin/w
IDBIN=/usr/bin/id
LSBIN=/usr/bin/ls
TRBIN=/usr/bin/tr
AWKBIN=/usr/bin/awk
CATBIN=/usr/bin/cat
CUTBIN=/usr/bin/cut
ENVBIN=/usr/bin/env
SEDBIN=/usr/bin/sed
FINDBIN=/usr/bin/find
GREPBIN=/usr/bin/grep
SUDOBIN=/usr/bin/sudo
TAILBIN=/usr/bin/tail
UNAMEBIN=/usr/bin/uname
XARGSBIN=/usr/bin/xargs
WHOAMIBIN=/usr/bin/whoami
CRONTABBIN=/usr/bin/crontab
LASTLOGBIN=/usr/bin/lastlog
SESTATUSBIN=/usr/sbin/sestatus
SYSTEMCTLBIN=/usr/bin/systemctl

IPSBIN=/sbin/ip
IFCONFIGSBIN=/sbin/ifconfig

USERNAME=$(${WHOAMIBIN})

BINLIST='aria2c\|arp\|ash\|awk\|base64\|bash\|busybox\|cat\|chmod\|chown\|cp\|csh\|curl\|cut\|dash\|date\|dd\|diff\|dmsetup\|docker\|ed\|emacs\|env\|expand\|expect\|file\|find\|flock\|fmt\|fold\|ftp\|gawk\|gdb\|gimp\|git\|grep\|head\|ht\|iftop\|ionice\|ip$\|irb\|jjs\|jq\|jrunscript\|ksh\|ld.so\|ldconfig\|less\|logsave\|lua\|make\|man\|mawk\|more\|mv\|mysql\|nano\|nawk\|nc\|netcat\|nice\|nl\|nmap\|node\|od\|openssl\|perl\|pg\|php\|pic\|pico\|python\|readelf\|rlwrap\|rpm\|rpmquery\|rsync\|ruby\|run-parts\|rvim\|scp\|script\|sed\|setarch\|sftp\|sh\|shuf\|socat\|sort\|sqlite3\|ssh$\|start-stop-daemon\|stdbuf\|strace\|systemctl\|tail\|tar\|taskset\|tclsh\|tee\|telnet\|tftp\|time\|timeout\|ul\|unexpand\|uniq\|unshare\|vi\|vim\|watch\|wget\|wish\|xargs\|xxd\|zip\|zsh'

function zshow() {
  echo -e "\e${1} ${3}:\e[00m"
  echo -e "${2}\n"
}

function zcheck() {
  if [ "${2}" ]; then
    zshow "${1}" "${2}" "${3}"
  fi
}

function zls() {
  xx=$(${LSBIN} ${2} 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zcat() {
  xx=$(${CATBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zfind() {
  xx=$(${FINDBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function zgrep() {
  xx=$(${GREPBIN} "${2}" 2>/dev/null)
  zcheck "${1}" "${xx}" "${3}"
}

function log_info() {
  echo "> $*"
}

function log_error() {
  echo "ERROR: $*" >&2
}

function log_warn() {
  echo "WARNING: $*" >&2
}

function log_detail() {
  echo ">> $*"
}

function do_system() {
  echo -e "\e[00;33m### SYSTEM ##############################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${UNAMEBIN} -a 2>/dev/null)" "Kernel information"
  fi

  zcat "[00;31m[-]" "${PATHNAME}/proc/version"  "Kernel information (continued)"
  zcat "[00;31m[-]" "${PATHNAME}/etc/*-release" "Specific release information"
  zcat "[00;31m[-]" "${PATHNAME}/etc/hostname"  "Hostname"
}

function do_usergroup() {
  echo -e "\e[00;33m### USER/GROUP ##########################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${IDBIN} 2>/dev/null)" "Current user/group info"

    lastlogedonusrs=$(${LASTLOGBIN} 2>/dev/null | ${TAILBIN} -n +2 | ${GREPBIN} -v 'Never' 2>/dev/null)
    zcheck "[00;31m[-]" "${lastlogedonusrs}" "Users that have previously logged onto the system"

    zcheck "[00;31m[-]" "$(${WBIN} 2>/dev/null | ${TAILBIN} -n +3)" "Who else is logged on"

    grpinfo=$(for i in $(${CUTBIN} -d':' -f1 /etc/passwd 2>/dev/null); do ${IDBIN} ${i}; done 2>/dev/null)
    zcheck "[00;31m[-]" "${grpinfo}" "Group memberships"

    adm_users=$(echo -e "${grpinfo}" | ${GREPBIN} '(adm)')
    zcheck "[00;31m[-]" "${adm_users}" "It looks like we have some admin users"
  fi

  zgrep "[00;33m[+]" "-v '^[^:]*:[x]' ${PATHNAME}/etc/passwd" "It looks like we have password hashes in ${PATHNAME}/etc/passwd"
  zcat  "[00;31m[-]" "${PATHNAME}/etc/passwd" "Contents of ${PATHNAME}/etc/passwd"
  zcat  "[00;33m[+]" "${PATHNAME}/etc/shadow" "We can read the shadow file"
  zcat  "[00;33m[+]" "${PATHNAME}/etc/master.passwd" "We can read the master.passwd file"

  superman=$(${GREPBIN} -v -E '^#' ${PATHNAME}/etc/passwd 2>/dev/null | ${AWKBIN} -F: '$3 == 0 {print $1}' 2>/dev/null)
  zcheck "[00;31m[-]" "${superman}" "Super user account(s)"

  sudoers=$(${GREPBIN} -v -e '^$' ${PATHNAME}/etc/sudoers 2>/dev/null | ${GREPBIN} -v '#' 2>/dev/null)
  zcheck "[00;31m[-]" "${sudoers}" "Sudoers configuration (condensed)"

  if [[ -z "${PATHNAME}" ]]; then
    sudoperms=$(echo '' | ${SUDOBIN} -S -l -k 2>/dev/null)
    zcheck "[00;33m[+]" "${sudoperms}" "We can sudo without supplying a password"

    if [ "${PASSWORD}" ]; then
      if [ "${sudoperms}" ]; then
        :
      else
        sudoauth=$(echo ${PASSWORD} | ${SUDOBIN} -S -l -k 2>/dev/null)
        zcheck "[00;33m[+]" "${sudoauth}" "We can sudo when supplying a password"
      fi
    fi

    if [ "${PASSWORD}" ]; then
      if [ "${sudoperms}" ]; then
        :
      else
        sudopermscheck=$(echo ${PASSWORD} | ${SUDOBIN} -S -l -k 2>/dev/null | ${XARGSBIN} -n 1 2>/dev/null | ${SEDBIN} 's/,*$//g' 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
        zcheck "[00;33m[-]" "${sudopermscheck}" "Possible sudo pwnage"
      fi
    fi

    sudopwnage=$(echo '' | ${SUDOBIN} -S -l -k 2>/dev/null | ${XARGSBIN} -n 1 2>/dev/null | ${SEDBIN} 's/,*$//g' 2>/dev/null | ${GREPBIN} -w ${BINLIST} 2>/dev/null)
    zcheck "[00;33m[+]" "${sudopwnage}" "Possible sudo pwnage"
  fi

  zfind "[00;31m[-]" "${PATHNAME}/home -name .sudo_as_admin_successful" "Accounts that have recently used sudo"
  zls "[00;33m[+]" "-ahl ${PATHNAME}/root/" "We can read root's home directory"
  zls "[00;31m[-]" "-ahl ${PATHNAME}/home/" "Are permissions on ${PATHNAME}/home directories lax"

  if [ "${EXTREME}" == "YES" ]; then
    grfilesall=$(${FINDBIN} ${PATHNAME}/ -writable ! -user ${USERNAME} -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${grfilesall}" "Files not owned by user but writable by group"
  fi

  if [ "${EXTREME}" == "YES" ]; then
    ourfilesall=$(${FINDBIN} ${PATHNAME}/ -user ${USERNAME} -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${ourfilesall}" "Files owned by our user"
  fi

  if [ "${EXTREME}" == "YES" ]; then
    hiddenfiles=$(${FINDBIN} ${PATHNAME}/ -name '.*' -type f ! -path '${PATHNAME}/proc/*' ! -path '${PATHNAME}/sys/*' -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${hiddenfiles}" "Hidden files"
  fi

  if [ "${EXTREME}" == "YES" ]; then
    wrfileshm=$(${FINDBIN} ${PATHNAME}/home/ -perm -4 -type f -exec ${LSBIN} -al {} \; 2>/dev/null)
    zcheck "[00;31m[-]" "${wrfileshm}" "World-readable files within ${PATHNAME}/home"
  fi

  if [ "${EXTREME}" == "YES" ] && [ -z "${PATHNAME}" ]; then
    zls "[00;31m[-]" "-ahl ${HOME}" "Home directory contents"
  fi

  sshfiles=$(${FINDBIN} ${PATHNAME}/ \( -name "id_dsa*" -o -name "id_rsa*" -o -name "known_hosts" -o -name "authorized_hosts" -o -name "authorized_keys" \) -exec ${LSBIN} -la {} 2>/dev/null \;)
  zcheck "[00;31m[-]" "${sshfiles}" "SSH keys/host information found in the following locations"

  sshrootlogin=$(${GREPBIN} 'PermitRootLogin ' ${PATHNAME}/etc/ssh/sshd_config 2>/dev/null | ${GREPBIN} -v '#' | ${AWKBIN} '{print  $2}')
  if [ "${sshrootlogin}" = "yes" ]; then
    zcheck "[00;31m[-]" "$(${GREPBIN} 'PermitRootLogin ' ${PATHNAME}/etc/ssh/sshd_config 2>/dev/null | ${GREPBIN} -v '#')" "Root is allowed to login via SSH"
  fi
}

function do_environment() {
  echo -e "\e[00;33m### ENVIRONMENTAL #######################################\e[00m"

  if [[ -z "${PATHNAME}" ]]; then
    zcheck "[00;31m[-]" "$(${ENVBIN} 2>/dev/null | ${GREPBIN} -v 'LS_COLORS' 2>/dev/null)" "Environment information"
    zcheck "[00;31m[-]" "$(${SESTATUSBIN} 2>/dev/null)" "SELinux seems to be present"

    pathinfo=$(echo ${PATH} 2>/dev/null)
    if [ "${pathinfo}" ]; then
      zcheck "[00;31m[-]" "$(${LSBIN} -ld $(echo ${PATH} | ${TRBIN} ':' ' '))" "Path information"
    fi
  fi

  zcat "[00;31m[-]" "${PATHNAME}/etc/shells" "Available shells"

  zcheck "[00;31m[-]" "$(umask -S 2>/dev/null & umask 2>/dev/null)" "Current umask value"

  zcheck "[00;31m[-]" "$(${GREPBIN} -i '^UMASK' ${PATHNAME}/etc/login.defs)" "umask value as specified in ${PATHNAME}/etc/login.defs"
  zcheck "[00;31m[-]" "$(${GREPBIN} '^PASS_MAX_DAYS\|^PASS_MIN_DAYS\|^PASS_WARN_AGE\|^ENCRYPT_METHOD' ${PATHNAME}/etc/login.defs)" "Password and storage information"
}

function do_job() {
  echo -e "\e[00;33m### JOBS/TASKS ##########################################\e[00m"

  zls "[00;31m[-]" "${PATHNAME}/etc/cron*" "Cron jobs"

  cronjobwwperms=$(${FINDBIN} ${PATHNAME}/etc/cron* -perm -0002 -type f -exec ${LSBIN} -la {} \; -exec ${CATBIN} {} 2>/dev/null \;)
  zcheck "[00;33m[+]" "${cronjobwwperms}" "World-writable cron jobs and file contents"

  zcat "[00;31m[-]" "${PATHNAME}/etc/crontab" "Crontab contents"
  zls "[00;31m[-]" "-la ${PATHNAME}/var/spool/cron/crontabs" "Anything interesting in ${PATHNAME}/var/spool/cron/crontabs"

  anacronjobs=$(${LSBIN} -la ${PATHNAME}/etc/anacrontab 2>/dev/null; ${CATBIN} ${PATHNAME}/etc/anacrontab 2>/dev/null)
  zcheck "[00;31m[-]" "${anacronjobs}" "Anacron jobs and associated file permissions"

  anacrontab=$(${LSBIN} -la ${PATHNAME}/var/spool/anacron 2>/dev/null)
  zcheck "[00;31m[-]" "${anacrontab}" "When were jobs last executed (${PATHNAME}/var/spool/anacron contents)"

  if [[ -z "${PATHNAME}" ]]; then
    cronother=$(${CUTBIN} -d ":" -f 1 ${PATHNAME}/etc/passwd | ${XARGSBIN} -n1 ${CRONTABBIN} -l -u 2>/dev/null)
    zcheck "[00;31m[-]" "${cronother}" "Jobs held by all users"

    if [ "${EXTREME}" == "YES" ]; then
      systemdtimers=$(${SYSTEMCTLBIN} list-timers --all 2>/dev/null)
    else
      systemdtimers=$(${SYSTEMCTLBIN} list-timers 2>/dev/null |head -n -1 2>/dev/null)
    fi
    zcheck "[00;31m[-]" "${systemdtimers}" "Systemd timers"
  fi
}

function do_network() {
  echo -e "\e[00;33m### NETWORKING  ##########################################\e[00m"

  nicinfo=$(${IFCONFIGSBIN} -a 2>/dev/null)
  zcheck "[00;31m[-]" "${nicinfo}" "Network and IP info"

  if [[ -z "${nicinfo}" ]]; then
    nicinfoip=$(${IPSBIN} a 2>/dev/null)
    zcheck "[00;31m[-]" "${nicinfoip}" "Network and IP info"
  fi
}

function check_root() {
  if [[ $EUID -ne 0 ]]; then
    log_error "This script must be run with root privileges."
    echo ""
    echo "Please run: sudo $0 $*"
    exit 1
  fi
}

function show_usage() {
  ${CATBIN} << EOF
Usage: ${SCRIPTNAME} v${SCRIPTVERSION}
EXAMPLES:
  ${SCRIPTNAME} job
  ${SCRIPTNAME} user
  ${SCRIPTNAME} system
  ${SCRIPTNAME} network
  ${SCRIPTNAME} environment
  ${SCRIPTNAME} -v|--version
  ${SCRIPTNAME} -h|--help
EOF
}

function show_version() {
  echo ${SCRIPTNAME} v${SCRIPTVERSION}
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case ${1} in
      environment|system|user|job|network)
        COMMAND=${1}
        shift # past argument
        ;;
      -v|--version)
        COMMAND=version
        shift # past argument
        ;;
      -h|--help)
        COMMAND=help
        shift # past argument
        ;;
      -p|--password)
        PASSWORD=${2}
        shift # past argument
        shift # past argument
        ;;
      -u|--username)
        USERNAME=${2}
        shift # past argument
        shift # past argument
        ;;
      -x|--extreme)
        EXTREME=YES
        shift # past argument
        ;;
      *)
        if [[ $# -eq 1 ]]; then
          PATHNAME=${1}
          shift # past argument
        else
          echo "Unknown option ${1}"
          show_usage
          exit 1
        fi
        ;;
    esac
  done
}

main() {
  parse_args "$@"

  if [ "${COMMAND}" == "help" ]; then
    show_usage
    exit 0
  elif [ "${COMMAND}" == "version" ]; then
    show_version
    exit 0
  fi

  check_root "$@"

  if [ "${COMMAND}" == "job" ]; then
    do_job
  elif [ "${COMMAND}" == "system" ]; then
    do_system
  elif [ "${COMMAND}" == "user" ]; then
    do_usergroup
  elif [ "${COMMAND}" == "environment" ]; then
    do_environment
  elif [ "${COMMAND}" == "network" ]; then
    do_network
  elif [[ -z "${COMMAND}" ]]; then
    do_system
    do_usergroup
    do_environment
    do_job
    do_network
  fi
}

main "$@"


