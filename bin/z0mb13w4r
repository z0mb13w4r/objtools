#!/bin/bash

SCRIPTVERSION=1.4
SCRIPTNAME=$(basename "$0")

JQBIN=/usr/bin/jq
LSBIN=/usr/bin/ls
MVBIN=/usr/bin/mv
RMBIN=/usr/bin/rm
TRBIN=/usr/bin/tr
APTBIN=/usr/bin/apt
CATBIN=/usr/bin/cat
CUTBIN=/usr/bin/cut
GITBIN=/usr/bin/git
TARBIN=/usr/bin/tar
TEEBIN=/usr/bin/tee
DPKGBIN=/usr/bin/dpkg
GREPBIN=/usr/bin/grep
GZIPBIN=/usr/bin/gzip
SUDOBIN=/usr/bin/sudo
WGETBIN=/usr/bin/wget
CHMODBIN=/usr/bin/chmod
CHOWNBIN=/usr/bin/chown
MKDIRBIN=/usr/bin/mkdir
UNZIPBIN=/usr/bin/7z
REMNUXBIN=/usr/local/bin/remnux
LSBRELEASEBIN=/usr/bin/lsb_release
ADDAPTBIN=/usr/bin/add-apt-repository

TMP=/tmp/
VIMTXT=/home/remnux/.vimrc
CYBERCHEF=/home/remnux/shared/cyberchef/
CYBERCHEFBASH=/usr/local/bin/cyberchef

GITHUBNAM=${TMP}github.nam
GITHUBTAG=${TMP}github.tag
GITHUBTXT=${TMP}github.txt
GITHUBZIP=${TMP}github.zip
GITHUBVER=${TMP}github.ver

function log_info() {
  echo "> $*"
}

function log_error() {
  echo "ERROR: $*" >&2
}

function log_warn() {
  echo "WARNING: $*" >&2
}

function log_detail() {
  echo ">> $*"
}

function check_root() {
  if [[ $EUID -ne 0 ]]; then
    log_error "This script must be run with root privileges."
    echo ""
    echo "Please run: sudo $0 $*"
    exit 1
  fi
}

function check_os() {
  if [[ ! -f /etc/os-release ]]; then
    log_error "Cannot determine operating system. /etc/os-release not found."
    exit 1
  fi

  source /etc/os-release

  if [[ "${ID:-}" != "ubuntu" ]]; then
    log_error "This script only supports Ubuntu. Detected: ${ID:-unknown}"
    exit 1
  fi

  local THIS_VERSION="${VERSION_ID:-}"
  if [[ "${THIS_VERSION}" != "24.04" ]]; then
    log_error "Unsupported Ubuntu version: ${THIS_VERSION}"
    log_error "Supported version: 24.04 LTS"
    exit 1
  fi

  log_detail "Detected Ubuntu ${VERSION}"
}

function do_remnux() {
  ${WGETBIN} https://REMnux.org/remnux
  ${CHMODBIN} +x remnux
  ${MVBIN} remnux ${REMNUXBIN}

  ${REMNUXBIN} install
}

function do_upgrade() {
  ${ADDAPTBIN} ppa:giuspen/ppa
  ${APTBIN} update
  ${APTBIN} upgrade -y

  ${APTBIN} install -y binutils-dev libssl-dev zlib1g-dev libfuzzy-dev
}

function do_config() {
  echo -n "Your name: "
  read -r THIS_USERNAME
  echo -n "Your email: "
  read -r THIS_EMAILADDR

  ${GITBIN} config --global user.name "'${THIS_USERNAME}'"
  ${GITBIN} config --global user.email "'${THIS_EMAILADDR}'"
}

function do_vimsetup() {
  echo 'set number' > ${VIMTXT}
  echo 'set autoindent' >> ${VIMTXT}
  echo 'set hlsearch' >> ${VIMTXT}
  echo 'set tabstop=2' >> ${VIMTXT}
  echo 'set softtabstop=2' >> ${VIMTXT}
  echo 'set shiftwidth=2' >> ${VIMTXT}
  echo 'set expandtab' >> ${VIMTXT}
  echo >> ${VIMTXT}
  echo '" Press F4 to toggle highlighting on/off, and show current value.' >> ${VIMTXT}
  echo ':noremap <F4> :set hlsearch! hlsearch?<CR>' >> ${VIMTXT}
  echo >> ${VIMTXT}
  echo '" Press return to temporarily get out of the highlighted search.' >> ${VIMTXT}
  echo ':nnoremap <CR> :nohlsearch<CR><CR>' >> ${VIMTXT}
  echo >> ${VIMTXT}
  echo '" Highlight trailing whitespaces' >> ${VIMTXT}
  echo ':highlight TrailWhitespace ctermbg=red guibg=red' >> ${VIMTXT}
  echo ':match TrailWhitespace /\s\+$\| \+\ze\t/' >> ${VIMTXT}
}

function do_gitsetup() {
  ${GITBIN} config --global core.editor vim
  ${GITBIN} config --global core.pager 'less -FRSX'
  ${GITBIN} config --global core.abbrev 12
  ${GITBIN} config --global color.ui auto
  ${GITBIN} config --global merge.tool vimdiff
  ${GITBIN} config --global difftool.prompt false
  ${GITBIN} config --global alias.unstage 'reset HEAD --'
  ${GITBIN} config --global alias.log-all 'log --graph --stat --patch --ignore-space-change'
  ${GITBIN} config --global alias.last 'log -1 HEAD'
  ${GITBIN} config --global pretty.fixes 'Fixes: %h (\"%s\")'
  ${GITBIN} config --global push.default simple
}

function do_debians() {
  ${APTBIN} install -y vim-gtk3 git git-doc git-email screen meld
  ${APTBIN} install -y python3-scapy python3-pyx
  ${APTBIN} install -y python3-nmap
  ${APTBIN} install -y cherrytree
  ${APTBIN} install -y john
}

function do_objtools() {
  ${WGETBIN} https://api.github.com/repos/z0mb13w4r/objtools/releases/latest -O ${GITHUBTXT}

  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.tag_name)' > ${GITHUBTAG}
  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].name | select(. | contains("24.04-amd64.deb")))' > ${GITHUBNAM}
  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].browser_download_url | select(. | contains("24.04-amd64.deb")))' > ${GITHUBZIP}

  local THIS_NAME=${TMP}$(${CATBIN} ${GITHUBNAM})

  ${RMBIN} ${THIS_NAME}
  ${WGETBIN} -P ${TMP} $(${CATBIN} ${GITHUBZIP})

  ${APTBIN} install -y ${THIS_NAME}
}

function do_veracrypt() {
  ${WGETBIN} https://api.github.com/repos/veracrypt/VeraCrypt/releases/latest -O ${GITHUBTXT}

  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.tag_name)' > ${GITHUBTAG}
  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].name | select(. | endswith("-Ubuntu-24.04-amd64.deb")))' | ${GREPBIN} -v console > ${GITHUBNAM}
  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].browser_download_url | select(. | endswith("-Ubuntu-24.04-amd64.deb")))' | ${GREPBIN} -v console > ${GITHUBZIP}

  local THIS_NAME=${TMP}$(${CATBIN} ${GITHUBNAM})

  ${RMBIN} ${THIS_NAME}
  ${WGETBIN} -P ${TMP} $(${CATBIN} ${GITHUBZIP})

  ${APTBIN} install -y ${THIS_NAME}
}

function do_cyberchef() {
  ${WGETBIN} https://api.github.com/repos/gchq/cyberchef/releases/latest -O ${GITHUBTXT}

  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].name | select(. | contains(".zip")))' > ${GITHUBNAM}
  ${CATBIN} ${GITHUBTXT} | ${JQBIN} -r '(.assets[].browser_download_url | select(. | contains(".zip")))' > ${GITHUBZIP}

  local THIS_NAME=${TMP}$(${CATBIN} ${GITHUBNAM})

  ${RMBIN} ${THIS_NAME}
  ${RMBIN} -rf ${CYBERCHEF}
  ${MKDIRBIN} -p ${CYBERCHEF}
  ${WGETBIN} -P ${TMP} $(${CATBIN} ${GITHUBZIP})

  ${UNZIPBIN} x ${THIS_NAME} -o${CYBERCHEF}
  ${CHOWNBIN} -R remnux:remnux ${CYBERCHEF}

  local THIS_NAME=$(${LSBIN} -1 ${CYBERCHEF}CyberChef_v*)

  echo "#!/bin/bash" | ${TEEBIN} ${CYBERCHEFBASH}
  echo "firefox ${THIS_NAME} &" | ${TEEBIN} -a ${CYBERCHEFBASH}
}

function do_wordlist() {
  local THAT_NAME=/usr/share/wordlists/
  local THIS_NAME=${THAT_NAME}/rockyou.txt.gz

  ${MKDIRBIN} -p ${THAT_NAME}
  ${WGETBIN} https://gitlab.com/kalilinux/packages/wordlists/-/raw/b6c914716e686b57a4253d7003512a3ecc328dd7/rockyou.txt.gz -O ${THIS_NAME}
  ${GZIPBIN} -d ${THIS_NAME}
}

function show_usage() {
  ${CATBIN} << EOF
Usage: ${SCRIPTNAME} v${SCRIPTVERSION}
EXAMPLES:
  ${SCRIPTNAME} config
  ${SCRIPTNAME} update
  ${SCRIPTNAME} install
  ${SCRIPTNAME} objtools
  ${SCRIPTNAME} wordlist
  ${SCRIPTNAME} cyberchef
  ${SCRIPTNAME} veracrypt
  ${SCRIPTNAME} version
  ${SCRIPTNAME} help
EOF
}

function show_version() {
  echo ${SCRIPTNAME} v${SCRIPTVERSION}
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case ${1} in
      config|install|update|objtools|veracrypt|version|help)
        COMMAND=${1}
        shift # past argument
        ;;
      *)
        echo "Unknown option ${1}"
        show_usage
        exit 1
        ;;
    esac
  done

  if [[ -z "${COMMAND}" ]]; then
    show_usage
    exit 1
  fi
}

main() {
  parse_args "$@"

  if [ "${COMMAND}" == "help" ]; then
    show_usage
    exit 0
  elif [ "${COMMAND}" == "version" ]; then
    show_version
    exit 0
  elif [ "${COMMAND}" == "config" ]; then
    do_config
    exit 0
  fi

  check_os
  check_root "$@"

  if [ "${COMMAND}" == "install" ]; then
    do_upgrade
    do_debians
    do_objtools
    do_veracrypt
    do_remnux
    do_cyberchef
    do_gitsetup
    do_vimsetup
    do_wordlist
  elif [ "${COMMAND}" == "update" ]; then
    do_upgrade
    do_remnux
    do_objtools
    do_veracrypt
    do_cyberchef
  elif [ "${COMMAND}" == "objtools" ]; then
    do_upgrade
    do_objtools
  elif [ "${COMMAND}" == "wordlist" ]; then
    do_wordlist
  elif [ "${COMMAND}" == "cyberchef" ]; then
    do_cyberchef
  elif [ "${COMMAND}" == "veracrypt" ]; then
    do_upgrade
    do_veracrypt
  fi
}

main "$@"

